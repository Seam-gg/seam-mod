{
  "schemaVersion": 1,
  "id": "seam_notebook",
  "version": "${version}",
  "name": "Seam Notebook",
  "description": "In-game companion for the Seam webapp — resource tracking, container tagging, and task check-off. The client half is the notebook; the optional server half reads tagged containers and reports what is in them.",
  "authors": ["Even Gultvedt"],
  "contact": {
    "homepage": "https://app.seam.gg",
    "sources": "https://github.com/Seam-gg/seam-mod",
    "issues": "https://github.com/Seam-gg/seam-mod/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "gg.seam.mod.SeamServer"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "gg.seam.mod.SeamClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  }
}
